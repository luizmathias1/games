{
  "name": "games-fps",
  "version": "0.1.0",
  "private": true,
  "description": "FPS multiplayer 1v1 para navegador (Three.js + WebSocket)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c magenta,cyan \"tsx watch server/src/index.ts\" \"vite\"",
    "build": "vite build && esbuild server/src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=server-dist/index.js",
    "start": "node server-dist/index.js",
    "typecheck": "tsc -p client/tsconfig.json && tsc -p server/tsconfig.json",
    "test": "tsx shared/physics.test.ts"
  },
  "dependencies": {
    "three": "^0.170.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.170.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
